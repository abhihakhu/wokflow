{
  "name": "@wokflow/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android shell for WokFlow (Capacitor). Wraps the same web build as the desktop app.",
  "type": "module",
  "scripts": {
    "build:web": "pnpm --filter @wokflow/desktop exec vite build",
    "sync": "pnpm build:web && cap sync android",
    "open": "cap open android",
    "apk": "pnpm sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  }
}
